  c3               -> [p_2@p_2_i_0]
  c4               -> [p_2@p_2_i_0]
  k1               -> [p_0@p_0_i_0]
  k2               -> [p_0@p_0_i_0]
  k3               -> [p_0@p_0_i_0]
  s                -> [p_1@p_1_i_0]
